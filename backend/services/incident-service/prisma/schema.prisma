// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum IncidentStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
}

enum Severity {
    LOW
    MEDIUM
    HIGH
    CRITICAL
}

enum AlertStatus {
    OPEN
    ACKNOWLEDGED
    RESOLVED
}

enum EventType {
    ERROR
    METRIC
    SECURITY
}

enum IntegrationProvider {
    WEBHOOK
    STRIPE
    GITHUB
    CUSTOM
}

model Incident {
    id            String         @id @default(uuid())
    title         String
    description   String?
    service       String
    status        IncidentStatus @default(OPEN)
    severity      Severity       @default(MEDIUM)
    severityScore Int            @default(0)

    fingerprint String
    tenantId    String
    createdById String

    alertCount  Int       @default(0)
    lastAlertAt DateTime?
    resolvedAt  DateTime?

    alerts Alert[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([tenantId, fingerprint, status])
    @@index([tenantId])
    @@index([fingerprint])
}

model Alert {
    id      String  @id @default(uuid())
    message String
    source  String?

    service     String
    fingerprint String

    severity Severity
    status   AlertStatus @default(OPEN)

    incidentId String?
    incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

    tenantId String

    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([incidentId])
}

model Event {
    id      String    @id @default(uuid())
    type    EventType
    source  String
    message String
    service String

    severity Severity

    tenantId String

    createdAt DateTime @default(now())

    @@index([tenantId])
}

model ThresholdConfig {
    id String @id @default(uuid())

    tenantId String
    service  String? // optional for per-service override

    mediumCount Int @default(10)
    lowCount    Int @default(20)
    highCount   Int @default(1)

    mediumWindowSeconds Int @default(120)
    lowWindowSeconds    Int @default(60)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tenantId])
    @@index([service])
}

model Integration {
    id       String  @id @default(uuid())
    name     String
    isActive Boolean @default(true)

    apiKey   String  @unique
    secret   String?
    metadata Json?

    provider IntegrationProvider
    tenantId String

    keys IntegrationKey[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model IntegrationKey {
    id            String    @id @default(uuid())
    hashedKey     String    @unique
    isPrimary     Boolean   @default(false)
    isActive      Boolean   @default(true)
    expiresAt     DateTime?
    integrationId String

    integration Integration @relation(fields: [integrationId], references: [id])

    createdAt DateTime @default(now())
}
